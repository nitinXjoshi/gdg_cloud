# PromptForge backend configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env`.

ENVIRONMENT=development

# --- LLM provider (Ollama only — no paid API required) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Database ---
# SQLite is used automatically in development/test when this is unset.
# For production, use a PostgreSQL URL:
# DATABASE_URL=postgresql+asyncpg://promptforge:promptforge@postgres:5432/promptforge
DATABASE_URL=

# --- Redis (optional) ---
# When unset, an in-memory rate limiter is used (fine for dev/tests).
REDIS_URL=

# --- Admin ---
# Required for admin endpoints. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=dev-admin-key-change-me

# --- Safety controls ---
MAX_PROMPT_LENGTH=12000
MAX_OUTPUT_TOKENS=1024
MAX_REQUESTS_PER_MINUTE=20
MAX_CONCURRENT_REQUESTS=10

# --- Ollama resilience ---
OLLAMA_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# --- Misc ---
STORE_PROMPTS=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
